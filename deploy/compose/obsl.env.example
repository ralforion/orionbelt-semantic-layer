# OBSL's own settings, as for `docker run --env-file`. Copy to obsl.env.
# Every setting is in the docs (Configuration, Data Sources).
# As shipped, OBSL starts with the example model built into its image.

QUERY_EXECUTE=true
# FLIGHT_ENABLED=true

# Your models: put the files in ./models (mounted at /models) and name them.
# MODEL_DIR=/models
# MODEL_FILES=model.yaml

# With the local lake (COMPOSE_PROFILES=lake): a DuckDB source named lake that
# reads files under /data and the lake's Iceberg tables in this process (guide:
# Files and Lakehouse Tables). Uncomment it with the profile; it attaches the
# lake's catalog, which runs only with the profile. For your own S3 and
# catalog, change the values.
# OBSL_DATABASES=lake
# DB_LAKE_TYPE=duckdb
# DB_LAKE_DUCKDB_DATABASE=:memory:
# DB_LAKE_DUCKDB_INIT_SQL=CREATE OR REPLACE SECRET lake_s3 (TYPE s3, KEY_ID 'lake-key', SECRET 'lake-secret', REGION 'us-east-1', ENDPOINT 'lake-s3:9000', URL_STYLE 'path', USE_SSL false); ATTACH IF NOT EXISTS 'warehouse' AS lake (TYPE iceberg, ENDPOINT 'http://lake-rest:8181', AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none')
# DB_LAKE_DUCKDB_CONNECTION_SQL=SET search_path = 'lake.sales'
# DB_LAKE_DUCKDB_ALLOWED_PATHS=/data/,s3://warehouse/,http://lake-rest:8181/
# DB_LAKE_DUCKDB_MEMORY_LIMIT=2GB

# With the workers (compose.pool.yml): the same source lake, its queries run
# on the workers instead (guide: DuckDB Workers). Uncomment it instead of the
# block above, not with it: a source on the workers takes none of DuckDB's
# in-process settings. The user and password are the ones the workers' init
# SQL creates; the search path needs that init SQL's lake block.
# OBSL_DATABASES=lake
# DB_LAKE_TYPE=duckdb
# DB_LAKE_DUCKDB_BACKEND=hardcharger
# DB_LAKE_HARDCHARGER_WORKERS=hardcharger://hardcharger-1?tls=false,hardcharger://hardcharger-2?tls=false
# DB_LAKE_HARDCHARGER_USER=obsl_lake
# DB_LAKE_HARDCHARGER_PASSWORD=change-me
# DB_LAKE_DUCKDB_CONNECTION_SQL=SET search_path = 'lake.sales'
