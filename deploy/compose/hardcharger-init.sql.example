-- What every DuckDB worker runs when it starts. Copy to secrets/hardcharger-init.sql
-- and fill in. It holds credentials: secrets/ is not committed.

-- One user per OBSL source, allowed to read what that source reads and nothing else.
CREATE ROLE IF NOT EXISTS lake_reader;
GRANT READ FILESYSTEM ON LOCATION '/data/' TO lake_reader;
CREATE USER IF NOT EXISTS obsl_lake WITH PASSWORD 'change-me';
GRANT lake_reader TO obsl_lake;

-- With the local lake (COMPOSE_PROFILES=lake): its S3 and its Iceberg catalog.
-- Uncomment these with the profile: a worker whose init SQL cannot attach the
-- catalog does not start. For your own S3 and catalog, change the values.
-- INSTALL httpfs; INSTALL avro; INSTALL iceberg;
-- LOAD httpfs; LOAD iceberg;
-- An object store or catalog that stops answering fails a query in about 30 s
-- (10 s, twice more), not DuckDB's 2 minutes. Each HTTP request may take 10 s.
-- SET GLOBAL http_timeout = 10;
-- SET GLOBAL http_retries = 2;
-- CREATE OR REPLACE SECRET lake_s3 (TYPE s3, KEY_ID 'lake-key', SECRET 'lake-secret', REGION 'us-east-1', ENDPOINT 'lake-s3:9000', URL_STYLE 'path', USE_SSL false);
-- ATTACH IF NOT EXISTS 'warehouse' AS lake (TYPE iceberg, ENDPOINT 'http://lake-rest:8181', AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none');
-- GRANT READ OBJECT STORAGE ON LOCATION 's3://warehouse/' TO lake_reader;
-- GRANT SELECT ON CATALOG lake TO lake_reader;
