# Compose's settings for this directory. Copy to .env (not committed).

# The files that make up the deployment (on Windows, separate them with ;):
#   compose.yml                    OBSL alone
#   compose.yml:compose.pool.yml   OBSL and DuckDB workers
COMPOSE_FILE=compose.yml

# A local lake for development: an S3 endpoint and an Iceberg REST catalog.
# COMPOSE_PROFILES=lake

# OBSL is built from this checkout, or runs a published image:
# OBSL_IMAGE=ralforion/orionbelt-semantic-layer-flight:<version>
# OB_EXTRA=flight             # the build with all eight database drivers; default: DuckDB only
# OBSL_PORT=8080
# OBSL_FLIGHT_PORT=8815
# OBSL_MODELS=./models
# OBSL_DATA=./data
# OBSL_ENV_FILE=obsl.env

# DuckDB workers (compose.pool.yml). Both are required with the workers.
HARDCHARGER_ADMIN_PASSWORD=
HARDCHARGER_SECRET_KEY=
# HARDCHARGER_INIT_SQL=./secrets/hardcharger-init.sql
# HC_CPUS=2
# HC_MEMORY=4g
# HC_DUCKDB_MEMORY=3GB        # DuckDB's memory limit, below HC_MEMORY
# HC_CONCURRENCY=4            # statements a worker runs at once
# HC_QUEUE=8                  # statements it queues beyond that; more are refused (HTTP 429)
# HC_QUERY_TIMEOUT=120
